# Copy to .env for local development. Defaults already target the mock stack.

# Connector: "mock" (in-memory) or "gcp" (Firestore + Cloud Storage)
CONNECTOR=mock

# Auth mode: "mock" (accept "dev:<email>" bearer tokens) or "firebase"
AUTH_MODE=mock

# Comma-separated emails allowed to use the admin CMS API
ADMIN_ALLOWED_EMAILS=admin@example.com

# CORS origins for browser clients
CORS_ORIGINS=http://localhost:5173,https://mematcha.github.io

# --- Only required when CONNECTOR=gcp ---
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)
GCS_BUCKET=
UPLOAD_URL_TTL_SECONDS=900
