# Frontend (Vite) environment variables. Copy to .env for local development.

# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:8000

# Auth mode: "mock" (local email dev sign-in) or "firebase" (production)
VITE_AUTH_MODE=mock

# Comma-separated admin emails allowed into the CMS UI (must match backend)
VITE_ADMIN_EMAILS=matcha.s@northeastern.edu

# --- Only required when VITE_AUTH_MODE=firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
